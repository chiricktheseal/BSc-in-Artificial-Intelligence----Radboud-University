\f0\fs24 \cf0 def sort[A](less: (A, A) => Boolean)(list: List[A]): List[A] = \{\
  def merge(left: List[A], right: List[A]): List[A] = (left, right) match \{\
    case (Nil, _) => right\
    case (_, Nil) => left\
    case (lhead :: ltail, rhead :: rtail) =>\
      if (less(lhead, rhead)) lhead :: merge(ltail, right)\
      else rhead :: merge(left, rtail)\
  \}\
\
  list match \{\
    case Nil => Nil\
    case head :: tail =>\
      val (lesser, greaterOrEqual) = tail.partition(x => less(x, head))\
      merge(sort(less)(lesser), head :: sort(less)(greaterOrEqual))\
  \}\
\}\
\
