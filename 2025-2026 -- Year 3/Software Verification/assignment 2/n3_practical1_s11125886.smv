MODULE main
VAR
  flag : array 0..1 of 0..4; --for processes 1 and 2 are flags 0 to 4
  proc0 : process Process(0, flag[0], flag[1], flag[2]); --id, itsflas, otherflag
  proc1 : process Process(1,  flag[1], flag[0], flag[2]);
  proc2 : process Process(2, flag[2], flag[0], flag[1]);
ASSIGN
  init(flag[0]) := 0;
  init(flag[1]) := 0;
  init(flag[2]) := 0;

-- ex 2  mutual exclusion
LTLSPEC 
  G !((proc0.state = l10 & proc1.state = l10) | 
      (proc0.state = l10 & proc2.state = l10) |
      (proc1.state = l10 & proc2.state = l10))

-- ex 2  each process that wants to enter its critical section will eventually succeed in doing so.
LTLSPEC 
  G (proc0.state = l2 -> F proc0.state = l10)
LTLSPEC 
  G (proc1.state = l2 -> F proc1.state = l10)
LTLSPEC 
  G (proc2.state = l2 -> F proc2.state = l10)


MODULE Process(id, my_flag, left_flag, right_flag)
VAR
  state : {l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12};
ASSIGN
  init(state) := l0;

  next(state) :=
    case
      state = l0 : l1;
      state = l1 : l2;      --l1: = NC
      state = l2 : l3;      --l2: flag[i] = 1

      state = l3 & (my_flag < 3) & (left_flag < 3) &(right_flag < 3) : l4;    --to get in l4: in l3 wait until all flag<3
      state = l3 : l3;           --if not satisfied condition   -- wait in l3
      state = l4 : l5;       -- l4: flag[i] := 3

      state = l5 & ((left_flag = 1) | (right_flag = 1)) : l6;  --if anyone flag=1
      state = l5 & !((left_flag = 1) | (right_flag = 1)) : l8; --othwewise go to l8

      state = l6 : l7;       -- l6: flag[i] := 2

      state = l7 & ((left_flag = 4) | (right_flag = 4)) : l8; --l7: wait until someone flag=4
      state = l7 : l7; --otherwise

      state = l8 : l9;       -- l8: flag[i] := 4
      state = l9 & (id = 0 ? TRUE : 
                    id = 1 ? (left_flag < 2) :
                    id = 2 ? (left_flag < 2) : TRUE) : l10;  --wait until left flag<2  (id=0 = no left and all time true)
      state = l9 : l9; 

      state = l10 : l11;  --CS
       state = l11 & (id = 0 ? (right_flag < 2 | right_flag > 3) :
                      id = 1 ? (right_flag < 2 | right_flag > 3) :
                      id = 2 ? TRUE : TRUE) : l12;  --wait until right flag<2 and >3  (for id=1 true since no right proc)
      state = l11 : l11;

      state = l12 : l0;      -- l12: flag[i] := 0
      TRUE : state;
    esac;
    
  next(my_flag) :=
    case
      state = l2 : 1;   -- flag[i] := 1
      state = l4 : 3;   -- flag[i] := 3
      state = l6 : 2;   -- flag[i] := 2
      state = l8 : 4;   -- flag[i] := 4
      state = l12 : 0;  -- flag[i] := 0
      TRUE : my_flag;
    esac;

FAIRNESS
  running

